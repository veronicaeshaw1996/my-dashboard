  <script>
    function generate120Sites() {
      const regions = [
        { name: 'ERCOT', baseTariff: 22.5, saidi: 7.9, count: 36, cities: ['Dallas', 'Houston', 'Austin', 'Fort Worth', 'San Antonio'] },
        { name: 'CAISO', baseTariff: 27.5, saidi: 4.0, count: 32, cities: ['Ontario', 'Fresno', 'Bakersfield', 'Sacramento', 'San Jose'] },
        { name: 'PJM', baseTariff: 18.5, saidi: 4.0, count: 28, cities: ['Chicago', 'Philadelphia', 'Columbus', 'Pittsburgh', 'Allentown'] },
        { name: 'MISO', baseTariff: 11.2, saidi: 4.1, count: 14, cities: ['Milwaukee', 'Des Moines', 'Indianapolis', 'Minneapolis'] },
        { name: 'NYISO', baseTariff: 24.2, saidi: 3.5, count: 10, cities: ['Syracuse', 'Albany', 'Buffalo', 'Rochester'] }
      ];

      const archetypes = [
        { type: 'Cold Storage', peakRange: [850, 1300], cutRatio: 0.28, baseProfile: [0.4,0.38,0.37,0.39,0.41,0.5,0.65,0.78,0.87,0.93,0.98,1.0,0.99,0.97,1.0,0.98,0.94,0.88,0.8,0.68,0.57,0.49,0.44,0.41] },
        { type: 'Light Industrial', peakRange: [650, 1050], cutRatio: 0.26, baseProfile: [0.29,0.28,0.28,0.3,0.41,0.65,0.88,0.98,1.0,0.99,1.0,0.98,0.95,0.98,0.99,0.96,0.92,0.71,0.49,0.36,0.32,0.31,0.29,0.29] },
        { type: 'Heavy Manufacturing', peakRange: [1200, 1800], cutRatio: 0.16, baseProfile: [0.86,0.85,0.84,0.86,0.87,0.91,0.94,0.97,0.99,1.0,0.99,0.99,0.99,1.0,0.99,0.99,0.98,0.96,0.93,0.89,0.87,0.86,0.86,0.86] }
      ];

      const solarProfileNorm = [0,0,0,0,0,0.06,0.23,0.46,0.69,0.89,0.97,1.0,0.97,0.86,0.69,0.43,0.17,0.03,0,0,0,0,0,0];

      const list = [];
      let idCounter = 1;

      regions.forEach(r => {
        for (let i = 0; i < r.count; i++) {
          const arch = archetypes[i % archetypes.length];
          const city = r.cities[i % r.cities.length];
          const peakKw = Math.round(arch.peakRange[0] + Math.random() * (arch.peakRange[1] - arch.peakRange[0]));
          const demandRate = Number((r.baseTariff + (Math.random() * 4 - 2)).toFixed(2));
          const saidi = Number((r.saidi + (Math.random() * 1.6 - 0.8)).toFixed(1));
          const peakCutKw = Math.round(peakKw * arch.cutRatio);

          const baseLoad = arch.baseProfile.map(f => Math.round(peakKw * f * (0.96 + Math.random() * 0.08)));
          const pvGen = solarProfileNorm.map(s => Math.round(peakCutKw * 1.25 * s));

          list.push({
            id: idCounter,
            name: `${city} Facility #${idCounter}`,
            region: r.name,
            type: arch.type,
            peakKw,
            demandRate,
            saidi,
            peakCutKw,
            baseLoad,
            pvGen
          });
          idCounter++;
        }
      });

      return list;
    }

    const siteData = generate120Sites();
    let currentSelectedSiteId = 1;
    let scatterChart, barChart, dispatchChart;

    function calculateMetrics(site, capex, downtimeCost) {
      const annualDemandSavings = (site.peakCutKw * site.demandRate) * 12;
      const annualResiliencyVal = site.saidi * downtimeCost;
      const totalAnnualBenefit = annualDemandSavings + annualResiliencyVal;
      const simplePayback = totalAnnualBenefit > 0 ? (capex / totalAnnualBenefit) : 99;
      
      let tierNumber = 3;
      let badgeClass = 'bg-rose-950 text-rose-400 border border-rose-800';
      if (simplePayback <= 6.0) {
        tierNumber = 1;
        badgeClass = 'bg-emerald-950 text-emerald-400 border border-emerald-800';
      } else if (simplePayback <= 8.5) {
        tierNumber = 2;
        badgeClass = 'bg-amber-950 text-amber-400 border border-amber-800';
      }

      return {
        annualDemandSavings,
        annualResiliencyVal,
        totalAnnualBenefit,
        simplePayback: Number(simplePayback.toFixed(1)),
        tier: tierNumber,
        badgeClass
      };
    }

    function updateDashboard() {
      const regionFilter = document.getElementById('filter-region').value;
      const typeFilter = document.getElementById('filter-type').value;
      const capex = parseFloat(document.getElementById('slider-capex').value);
      const downtimeCost = parseFloat(document.getElementById('slider-downtime').value);

      document.getElementById('label-capex').innerText = '$' + (capex).toLocaleString();
      document.getElementById('label-downtime').innerText = '$' + (downtimeCost).toLocaleString() + '/hr';

      const filtered = siteData.filter(s => {
        const matchesRegion = (regionFilter === 'ALL' || s.region === regionFilter);
        const matchesType = (typeFilter === 'ALL' || s.type === typeFilter);
        return matchesRegion && matchesType;
      });

      let totalDemandSavings = 0, totalResiliency = 0, totalPayback = 0, tier1Count = 0;

      const evaluatedList = filtered.map(site => {
        const m = calculateMetrics(site, capex, downtimeCost);
        totalDemandSavings += m.annualDemandSavings;
        totalResiliency += m.annualResiliencyVal;
        totalPayback += m.simplePayback;
        if (m.tier === 1) tier1Count++;
        return { ...site, ...m };
      });

      const count = evaluatedList.length;
      const avgPayback = count > 0 ? (totalPayback / count).toFixed(1) : 0;
      const avgDemand = count > 0 ? Math.round(totalDemandSavings / count) : 0;
      const avgResiliency = count > 0 ? Math.round(totalResiliency / count) : 0;
      const tier1Pct = count > 0 ? Math.round((tier1Count / count) * 100) : 0;

      document.getElementById('kpi-total-sites').innerText = count;
      document.getElementById('kpi-tier1-count').innerText = `${tier1Pct}% (${tier1Count})`;
      document.getElementById('kpi-avg-payback').innerText = `${avgPayback} Yrs`;
      document.getElementById('kpi-avg-demand-savings').innerText = `$${avgDemand.toLocaleString()}`;
      document.getElementById('kpi-avg-resiliency').innerText = `$${avgResiliency.toLocaleString()}`;

      renderTable(evaluatedList, capex);
      updateScatterChart(evaluatedList);
      updateDispatchChart();
    }

    function renderTable(list, capex) {
      const tbody = document.getElementById('site-table-body');
      tbody.innerHTML = '';

      if (list.length === 0) {
        tbody.innerHTML = `<tr><td colspan='5' class='text-center p-4 text-gray-500'>No sites matching selected filters</td></tr>`;
        return;
      }

      list.forEach(site => {
        const tr = document.createElement('tr');
        tr.className = `cursor-pointer transition hover:bg-gray-800 ${site.id === currentSelectedSiteId ? 'bg-gray-800/90 font-medium' : ''}`;
        tr.onclick = () => {
          currentSelectedSiteId = site.id;
          updateDashboard();
        };

        tr.innerHTML = `
          <td class='p-2.5 font-medium text-white'>${site.name}</td>
          <td class='p-2.5 text-gray-400'>${site.region}</td>
          <td class='p-2.5 text-gray-300'>$${site.demandRate.toFixed(2)}</td>
          <td class='p-2.5 font-semibold ${site.simplePayback <= 6.0 ? 'text-emerald-400' : (site.simplePayback <= 8.5 ? 'text-amber-400' : 'text-rose-400')}'>${site.simplePayback}y</td>
          <td class='p-2.5 text-center'><span class='inline-block w-5 text-center py-0.5 rounded text-[11px] font-bold ${site.badgeClass}'>${site.tier}</span></td>
        `;
        tbody.appendChild(tr);
      });

      const selectedSite = siteData.find(s => s.id === currentSelectedSiteId) || siteData[0];
      const downtimeCost = parseFloat(document.getElementById('slider-downtime').value);
      const metrics = calculateMetrics(selectedSite, capex, downtimeCost);
      const tenYrBenefit = (metrics.totalAnnualBenefit * 10) - capex;

      document.getElementById('table-annual-benefit').innerText = `$${Math.round(metrics.totalAnnualBenefit).toLocaleString()} / yr`;
      document.getElementById('table-10yr-roi').innerText = `${tenYrBenefit >= 0 ? '+' : ''}$${Math.round(tenYrBenefit).toLocaleString()}`;
      document.getElementById('table-10yr-roi').className = `font-semibold ${tenYrBenefit >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;
    }

    function initCharts() {
      const ctxScatter = document.getElementById('scatterChart').getContext('2d');
      scatterChart = new Chart(ctxScatter, {
        type: 'scatter',
        data: { datasets: [] },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: (ctx) => `${ctx.raw.name}: Tariff $${ctx.raw.x}/kW | Payback: ${ctx.raw.y} yrs | Status: ${ctx.raw.tier}`
              }
            }
          },
          scales: {
            x: {
              title: { display: true, text: 'Demand Charge ($/kW)', color: '#9CA3AF', font: { size: 11 } },
              grid: { color: '#374151' },
              ticks: { color: '#9CA3AF' }
            },
            y: {
              title: { display: true, text: 'Simple Payback (Years)', color: '#9CA3AF', font: { size: 11 } },
              grid: { color: '#374151' },
              ticks: { color: '#9CA3AF' },
              min: 0,
              max: 30
            }
          }
        }
      });

      const ctxBar = document.getElementById('barChart').getContext('2d');
      barChart = new Chart(ctxBar, {
        type: 'bar',
        data: {
          labels: ['ERCOT (TX)', 'MISO (Midwest)', 'CAISO (CA)', 'PJM (Mid-Atl)', 'NYISO (NY)'],
          datasets: [{
            label: 'Avg Outage (Hours/Yr)',
            data: [7.9, 4.1, 4.0, 4.0, 3.5],
            backgroundColor: ['#F59E0B', '#3B82F6', '#3B82F6', '#3B82F6', '#00A896'],
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: false }, ticks: { color: '#9CA3AF', font: { size: 10 } } },
            y: {
              title: { display: true, text: 'SAIDI Hours/Year', color: '#9CA3AF', font: { size: 10 } },
              grid: { color: '#374151' },
              ticks: { color: '#9CA3AF' }
            }
          }
        }
      });

      const ctxDispatch = document.getElementById('dispatchChart').getContext('2d');
      dispatchChart = new Chart(ctxDispatch, {
        type: 'line',
        data: { labels: [], datasets: [] },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: {
              position: 'top',
              labels: { color: '#D1D5DB', boxWidth: 12, font: { size: 11 } }
            }
          },
          scales: {
            x: { grid: { color: '#374151' }, ticks: { color: '#9CA3AF' } },
            y: {
              title: { display: true, text: 'Power Demand (kW)', color: '#9CA3AF', font: { size: 11 } },
              grid: { color: '#374151' },
              ticks: { color: '#9CA3AF' }
            }
          }
        }
      });
    }

    function updateScatterChart(list) {
      const dataPoints = list.map(s => ({
        x: s.demandRate,
        y: s.simplePayback,
        name: s.name,
        tier: s.tier
      }));

      scatterChart.data = {
        datasets: [{
          data: dataPoints,
          pointRadius: 5,
          pointHoverRadius: 7,
          pointBackgroundColor: dataPoints.map(p => p.tier === 1 ? '#00A896' : (p.tier === 2 ? '#F59E0B' : '#EF4444'))
        }]
      };
      scatterChart.update();
    }

    function updateDispatchChart() {
      const site = siteData.find(s => s.id === currentSelectedSiteId) || siteData[0];
      const hours = ['12A','1A','2A','3A','4A','5A','6A','7A','8A','9A','10A','11A','12P','1P','2P','3P','4P','5P','6P','7P','8P','9P','10P','11P'];
      
      const netGridLoad = site.baseLoad.map((load, idx) => {
        const netAfterSolar = Math.max(0, load - site.pvGen[idx]);
        if (idx >= 14 && idx <= 19) {
          return Math.max(load - site.peakCutKw, 0);
        }
        return netAfterSolar;
      });

      document.getElementById('dispatch-subtitle').innerText = `Facility: ${site.name} (${site.region})`;
      document.getElementById('detail-base-peak').innerText = `${site.peakKw} kW`;
      document.getElementById('detail-net-peak').innerText = `${site.peakKw - site.peakCutKw} kW`;
      const cutPct = ((site.peakCutKw / site.peakKw) * 100).toFixed(1);
      document.getElementById('detail-demand-cut').innerText = `${site.peakCutKw} kW (${cutPct}%)`;

      dispatchChart.data = {
        labels: hours,
        datasets: [
          {
            label: 'Gross Facility Load (kW)',
            data: site.baseLoad,
            borderColor: '#9CA3AF',
            borderWidth: 2,
            borderDash: [4, 4],
            fill: false,
            tension: 0.3
          },
          {
            label: 'Solar PV Output (kW)',
            data: site.pvGen,
            borderColor: '#F59E0B',
            backgroundColor: 'rgba(245, 158, 11, 0.15)',
            borderWidth: 1.5,
            fill: true,
            tension: 0.3
          },
          {
            label: 'Net Grid Draw Post-Microgrid (kW)',
            data: netGridLoad,
            borderColor: '#00A896',
            backgroundColor: 'rgba(0, 168, 150, 0.25)',
            borderWidth: 2.5,
            fill: true,
            tension: 0.3
          }
        ]
      };
      dispatchChart.update();
    }

    window.addEventListener('DOMContentLoaded', () => {
      initCharts();
      updateDashboard();

      document.getElementById('filter-region').addEventListener('change', updateDashboard);
      document.getElementById('filter-type').addEventListener('change', updateDashboard);
      document.getElementById('slider-capex').addEventListener('input', updateDashboard);
      document.getElementById('slider-downtime').addEventListener('input', updateDashboard);
    });
  </script>
</body>
